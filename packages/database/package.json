{
  "name": "@pratto/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "development": "./src/testing/index.ts",
      "require": "./dist/testing/index.js",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc --module commonjs --moduleResolution node --outDir dist --declaration --declarationMap false --noEmit false",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:test:reset": "dotenv -e ../../.env.test -o -- prisma migrate reset --force --skip-seed --skip-generate",
    "db:test:seed": "dotenv -e ../../.env.test -o -- tsx prisma/seed.ts",
    "lint": "eslint src prisma test",
    "test": "pnpm db:test:reset && dotenv -e ../../.env.test -o -- jest --config jest.config.cjs --runInBand",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "argon2": "^0.45.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@pratto/config": "workspace:*",
    "@pratto/eslint-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.5",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.14.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
