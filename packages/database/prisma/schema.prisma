generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LifecycleStatus {
  ACTIVE
  INACTIVE

  @@map("lifecycle_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum MenuStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("menu_status")
}

enum ProductAvailability {
  AVAILABLE
  TEMPORARILY_UNAVAILABLE
  HIDDEN

  @@map("product_availability")
}

enum ProductMediaType {
  IMAGE
  VIDEO

  @@map("product_media_type")
}

enum AnalyticsEventType {
  MENU_OPENED
  PRODUCT_IMPRESSION
  PRODUCT_VIEWED
  PRODUCT_INTERACTION
  CATEGORY_SELECTED

  @@map("analytics_event_type")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                @unique(map: "users_email_key") @db.VarChar(320)
  name                 String                @db.VarChar(120)
  status               LifecycleStatus       @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions             Session[]
  memberships          Membership[]
  credential           PasswordCredential?
  passwordResetToken   PasswordResetToken?
  authenticationEvents AuthenticationEvent[]
  publishedPublications MenuPublication[] @relation("MenuPublicationPublisher")

  @@map("users")
}

model Session {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  activeMembershipId   String?               @map("active_membership_id") @db.Uuid
  tokenHash            String                @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  expiresAt            DateTime              @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt    DateTime              @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt           DateTime?             @map("last_seen_at") @db.Timestamptz(3)
  revokedAt            DateTime?             @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeMembership     Membership?           @relation("ActiveMembership", fields: [activeMembershipId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  authenticationEvents AuthenticationEvent[]

  @@index([userId, revokedAt], map: "sessions_user_id_revoked_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@index([absoluteExpiresAt], map: "sessions_absolute_expires_at_idx")
  @@index([activeMembershipId], map: "sessions_active_membership_id_idx")
  @@map("sessions")
}

model PasswordCredential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("password_credentials")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique(map: "password_reset_tokens_user_id_key") @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt, usedAt], map: "password_reset_tokens_expires_at_used_at_idx")
  @@map("password_reset_tokens")
}

model AuthRateLimitBucket {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action          String    @db.VarChar(40)
  trackerHash     String    @map("tracker_hash") @db.VarChar(128)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  count           Int       @default(0)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([action, trackerHash], map: "auth_rate_limit_buckets_action_tracker_hash_key")
  @@index([blockedUntil], map: "auth_rate_limit_buckets_blocked_until_idx")
  @@map("auth_rate_limit_buckets")
}

model AuthenticationEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(60)
  outcome        String   @db.VarChar(20)
  subjectHash    String?  @map("subject_hash") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  session        Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt], map: "authentication_events_user_id_created_at_idx")
  @@index([eventType, createdAt], map: "authentication_events_event_type_created_at_idx")
  @@map("authentication_events")
}

model Organization {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(120)
  status         LifecycleStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships    Membership[]
  establishments Establishment[]

  @@map("organizations")
}

model Membership {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           MembershipRole
  status         LifecycleStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  activeSessions Session[]       @relation("ActiveMembership")
  publishedPublications MenuPublication[] @relation("MenuPublicationPublisherMembership")

  @@unique([organizationId, userId], map: "memberships_organization_id_user_id_key")
  @@unique([id, userId], map: "memberships_id_user_id_key")
  @@index([organizationId, status, role], map: "memberships_organization_id_status_role_idx")
  @@index([userId, status], map: "memberships_user_id_status_idx")
  @@map("memberships")
}

model Establishment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  publicId              String          @unique(map: "establishments_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  name                  String          @db.VarChar(120)
  slug                  String          @db.VarChar(80)
  description           String?         @db.Text
  phone                 String?         @db.VarChar(30)
  whatsapp              String?         @db.VarChar(30)
  address               Json?
  operatingHours        Json            @default("{}") @map("operating_hours")
  logoKey               String?         @map("logo_key") @db.VarChar(512)
  logoContentType       String?         @map("logo_content_type") @db.VarChar(100)
  coverImageKey         String?         @map("cover_image_key") @db.VarChar(512)
  coverImageContentType String?         @map("cover_image_content_type") @db.VarChar(100)
  themeSettings         Json            @default("{\"mode\":\"LIGHT\",\"primaryColor\":\"#166534\"}") @map("theme_settings")
  status                LifecycleStatus @default(ACTIVE)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  menus                 Menu[]
  analyticsSessions     AnalyticsSession[]
  analyticsEvents       AnalyticsEvent[]

  @@unique([organizationId, slug], map: "establishments_organization_id_slug_key")
  @@unique([id, organizationId], map: "establishments_id_organization_id_key")
  @@index([organizationId, status], map: "establishments_organization_id_status_idx")
  @@map("establishments")
}

model Menu {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  name            String        @db.VarChar(120)
  status          MenuStatus    @default(DRAFT)
  activePublicationId String?    @map("active_publication_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  establishment   Establishment @relation(fields: [establishmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  activePublication MenuPublication? @relation("MenuActivePublication", fields: [activePublicationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  publications      MenuPublication[] @relation("MenuPublications")
  categories        Category[]
  products          Product[]
  analyticsEvents   AnalyticsEvent[]

  @@unique([establishmentId, name], map: "menus_establishment_id_name_key")
  @@unique([id, organizationId], map: "menus_id_organization_id_key")
  @@unique([id, organizationId, establishmentId], map: "menus_id_organization_id_establishment_id_key")
  @@unique([activePublicationId, organizationId], map: "menus_active_publication_id_organization_id_key")
  @@index([organizationId, establishmentId, status], map: "menus_organization_id_establishment_id_status_idx")
  @@map("menus")
}

model Category {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  menuId         String          @map("menu_id") @db.Uuid
  name           String          @db.VarChar(120)
  normalizedName String          @map("normalized_name") @db.VarChar(120)
  description    String?         @db.Text
  displayOrder   Int             @default(0) @map("display_order")
  status         LifecycleStatus @default(ACTIVE)
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  menu           Menu            @relation(fields: [menuId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  products       Product[]

  @@unique([id, organizationId], map: "categories_id_organization_id_key")
  @@unique([id, organizationId, menuId], map: "categories_id_organization_id_menu_id_key")
  @@index([menuId, normalizedName], map: "categories_menu_id_normalized_name_idx")
  @@index([organizationId, menuId, archivedAt, displayOrder], map: "categories_org_menu_archived_order_idx")
  @@map("categories")
}

model Product {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  menuId            String             @map("menu_id") @db.Uuid
  categoryId        String             @map("category_id") @db.Uuid
  name              String             @db.VarChar(180)
  description       String?            @db.Text
  price             Decimal            @db.Decimal(10, 2)
  promotionalPrice  Decimal?           @map("promotional_price") @db.Decimal(10, 2)
  ingredients       String?            @db.Text
  allergens         String?            @db.Text
  availability      ProductAvailability @default(AVAILABLE)
  featured          Boolean            @default(false)
  status            LifecycleStatus    @default(ACTIVE)
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(3)
  displayOrder      Int                @default(0) @map("display_order")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  menu              Menu               @relation(fields: [menuId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  category          Category           @relation(fields: [categoryId, organizationId, menuId], references: [id, organizationId, menuId], onDelete: Restrict, onUpdate: Cascade)
  media             ProductMedia[]

  @@unique([id, organizationId], map: "products_id_organization_id_key")
  @@unique([id, organizationId, menuId], map: "products_id_organization_id_menu_id_key")
  @@index([organizationId, menuId, archivedAt, displayOrder], map: "products_org_menu_archived_order_idx")
  @@index([organizationId, menuId, categoryId], map: "products_org_menu_category_idx")
  @@map("products")
}

model ProductMedia {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  menuId         String          @map("menu_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  mediaType      ProductMediaType @map("media_type")
  contentType    String          @map("content_type") @db.VarChar(100)
  originalName   String          @map("original_name") @db.VarChar(255)
  storageKey     String          @unique(map: "product_media_storage_key_key") @map("storage_key") @db.VarChar(512)
  sizeBytes      Int             @map("size_bytes")
  displayOrder   Int             @default(0) @map("display_order")
  isPrimary      Boolean         @default(false) @map("is_primary")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        Product         @relation(fields: [productId, organizationId, menuId], references: [id, organizationId, menuId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId], map: "product_media_id_organization_id_key")
  @@index([organizationId, menuId, productId, displayOrder], map: "product_media_org_menu_product_order_idx")
  @@index([organizationId, menuId, productId, isPrimary], map: "product_media_org_menu_product_primary_idx")
  @@map("product_media")
}

model MenuPublication {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  menuId           String       @map("menu_id") @db.Uuid
  version          Int
  snapshot         Json
  publishedAt      DateTime     @default(now()) @map("published_at") @db.Timestamptz(3)
  publishedBy      String       @map("published_by") @db.Uuid
  idempotencyKey   String       @map("idempotency_key") @db.VarChar(128)
  menu             Menu         @relation("MenuPublications", fields: [menuId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  publisher        User         @relation("MenuPublicationPublisher", fields: [publishedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publisherMembership Membership @relation("MenuPublicationPublisherMembership", fields: [organizationId, publishedBy], references: [organizationId, userId], onDelete: Restrict, onUpdate: Cascade)
  activeMenu       Menu?        @relation("MenuActivePublication")
  analyticsEvents  AnalyticsEvent[]

  @@unique([id, organizationId], map: "menu_publications_id_organization_id_key")
  @@unique([id, organizationId, menuId], map: "menu_publications_id_organization_id_menu_id_key")
  @@unique([menuId, version], map: "menu_publications_menu_id_version_key")
  @@unique([menuId, idempotencyKey], map: "menu_publications_menu_id_idempotency_key_key")
  @@index([organizationId, menuId, publishedAt], map: "menu_publications_organization_id_menu_id_published_at_idx")
  @@index([organizationId, publishedAt], map: "menu_publications_organization_id_published_at_idx")
  @@map("menu_publications")
}

model AnalyticsSession {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  establishmentId String      @map("establishment_id") @db.Uuid
  firstSeenAt    DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  establishment  Establishment @relation(fields: [establishmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  events         AnalyticsEvent[]

  @@unique([id, organizationId, establishmentId], map: "analytics_sessions_id_organization_id_establishment_id_key")
  @@index([organizationId, establishmentId, lastSeenAt], map: "analytics_sessions_org_establishment_last_seen_idx")
  @@index([expiresAt], map: "analytics_sessions_expires_at_idx")
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id                String             @id @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  establishmentId   String             @map("establishment_id") @db.Uuid
  menuId            String             @map("menu_id") @db.Uuid
  publicationId     String             @map("publication_id") @db.Uuid
  sessionId         String             @map("session_id") @db.Uuid
  eventType         AnalyticsEventType @map("event_type")
  productId         String?            @map("product_id") @db.Uuid
  categoryId        String?            @map("category_id") @db.Uuid
  interactionType   String?            @map("interaction_type") @db.VarChar(40)
  intersectionRatio Decimal?           @map("intersection_ratio") @db.Decimal(4, 3)
  durationMs        Int?               @map("duration_ms")
  occurredAt        DateTime           @map("occurred_at") @db.Timestamptz(3)
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  payloadHash       String             @map("payload_hash") @db.VarChar(64)
  dedupeKey         String             @unique(map: "analytics_events_dedupe_key_key") @map("dedupe_key") @db.VarChar(512)
  establishment     Establishment     @relation(fields: [establishmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  menu              Menu               @relation(fields: [menuId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  publication       MenuPublication    @relation(fields: [publicationId, organizationId, menuId], references: [id, organizationId, menuId], onDelete: Restrict, onUpdate: Cascade)
  session           AnalyticsSession   @relation(fields: [sessionId, organizationId, establishmentId], references: [id, organizationId, establishmentId], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, establishmentId, occurredAt], map: "analytics_events_org_establishment_occurred_idx")
  @@index([organizationId, publicationId, eventType, occurredAt], map: "analytics_events_publication_type_occurred_idx")
  @@index([organizationId, menuId, eventType, occurredAt], map: "analytics_events_menu_type_occurred_idx")
  @@index([organizationId, productId, eventType, occurredAt], map: "analytics_events_product_type_occurred_idx")
  @@index([organizationId, categoryId, eventType, occurredAt], map: "analytics_events_category_type_occurred_idx")
  @@index([organizationId, sessionId, occurredAt], map: "analytics_events_session_occurred_idx")
  @@map("analytics_events")
}

model AnalyticsRateLimitBucket {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action          String    @db.VarChar(64)
  trackerHash     String    @map("tracker_hash") @db.VarChar(128)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  count           Int       @default(0)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([action, trackerHash], map: "analytics_rate_limit_buckets_action_tracker_hash_key")
  @@index([blockedUntil], map: "analytics_rate_limit_buckets_blocked_until_idx")
  @@map("analytics_rate_limit_buckets")
}
