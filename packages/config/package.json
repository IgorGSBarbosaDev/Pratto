    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@pratto/eslint-config": "workspace:*",
    "@types/node": "^22.16.5",
    "typescript": "^5.8.3"
  }
}
